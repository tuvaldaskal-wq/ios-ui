# Build intermediates
/build/
*.flat
*.flat.zip

# Local debug signing key (regenerated by build.sh)
/debug.keystore
dist/*.idsig

# Assistant project
/assistant/build/
/assistant/debug.keystore
# Do not publish assistant APKs (may embed a key in local builds)
/assistant/dist/
# Gradle / Android Studio build output and local config.
# local.properties holds the API key (ANTHROPIC_API_KEY) and must never be committed.
/assistant/.gradle/
/assistant/app/build/
/assistant/local.properties
