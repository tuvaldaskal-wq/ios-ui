<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270"
                android:startColor="@color/bg_top" android:endColor="@color/bg_bottom" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.15" android:centerY="0.10"
                android:gradientRadius="420dp"
                android:startColor="#553B82F6" android:endColor="#003B82F6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.9" android:centerY="0.32"
                android:gradientRadius="380dp"
                android:startColor="#558B5CF6" android:endColor="#008B5CF6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.5" android:centerY="0.95"
                android:gradientRadius="460dp"
                android:startColor="#44EC4899" android:endColor="#00EC4899" />
        </shape>
    </item>
</layer-list>
